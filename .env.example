NODE_ENV=development
PORT=5000
# Comma-separated list of allowed frontend origins (also used in password-reset links)
FRONTEND_URL=http://localhost:5173
MONGO_URI=mongodb://localhost:27017/relationshipapp
# Required in production, at least 32 random characters: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Set to the number of proxies in front of the app (e.g. 1 behind nginx/Render/Heroku)
TRUST_PROXY=
# Sign-up and login attempts allowed per IP every 15 minutes (default 100)
AUTH_RATE_LIMIT_MAX=
# Requests allowed per IP every 15 minutes across the whole API (default 1000)
API_RATE_LIMIT_MAX=

# Outgoing email (password reset). Without SMTP_HOST, emails are printed to the log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Relationship App <no-reply@example.com>"
