NODE_ENV=development
PORT=5000
# Comma-separated list of allowed frontend origins (also used in password-reset links)
FRONTEND_URL=http://localhost:5173
MONGO_URI=mongodb://localhost:27017/relationshipapp
# Required in production, at least 32 random characters: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Set to the number of proxies in front of the app (e.g. 1 behind nginx/Render/Heroku)
TRUST_PROXY=
# Owner(s) of the app, by email, comma-separated. They can reply to feedback and remove any of it.
ADMIN_EMAILS=

# Sign-up and login requests allowed per internet address every 15 minutes (default 300)
AUTH_RATE_LIMIT_MAX=
# Requests allowed every 15 minutes across the API:
#   per signed-in person (default 1500)
USER_RATE_LIMIT_MAX=
#   per internet address, for visitors who are not signed in (default 600)
API_RATE_LIMIT_MAX=
# Wrong passwords allowed per account per address every 15 minutes (default 20)
LOGIN_FAILURE_LIMIT=

# Outgoing email (password reset). Without SMTP_HOST, emails are printed to the log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Twogether <no-reply@example.com>"
